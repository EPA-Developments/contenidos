<!-- Start Doctor Area -->
<div class="professional-doctors-area-without-image pt-100 pb-100">
            <div class="container">
                <div class="section-title">
                    <h2>We are Experienced Healthcare Professionals</h2>
                </div>
                 <div class="row justify-content-center">
            <?php include("include/doctors-search.php") ?>

            <?php
            $servername = "13.235.191.177";
            $username = "mhcpanel_docdb";
            $password = "ki@mo#roi";
            $dbname = "mhcpanel_docdb";

            // Create connection
            $conn = new mysqli($servername, $username, $password, $dbname);
            // Check connection
            if ($conn->connect_error) {
                die("Connection failed: " . $conn->connect_error);
            }

            // Capture filter values from POST request
            $experience = isset($_POST['experience']) ? $_POST['experience'] : '';
            $location = isset($_POST['location']) ? $_POST['location'] : '';

            // Fetch locations to populate the location filter
            $locationQuery = "SELECT DISTINCT location FROM doctors WHERE speciality='cardiologists' AND status='Active'";
            $locations = $conn->query($locationQuery);

            // Base query to fetch doctors
            $sql = "SELECT * FROM doctors WHERE speciality='cardiologists' AND status='Active'";

            // Dynamically add filters to query if set
            if (!empty($experience)) {
                $sql .= " AND experience = ?";
            }
            if (!empty($location)) {
                $sql .= " AND location = ?";
            }

            // Prepare the query
            $stmt = $conn->prepare($sql);

            // Bind parameters if filters are set
            if (!empty($experience) && !empty($location)) {
                $stmt->bind_param("ss", $experience, $location);
            } elseif (!empty($experience)) {
                $stmt->bind_param("s", $experience);
            } elseif (!empty($location)) {
                $stmt->bind_param("s", $location);
            }

            // Execute the query
	            $stmt->execute();
            $result = $stmt->get_result();

            // Check if there are results
            if ($result->num_rows > 0) {
                while ($row = $result->fetch_assoc()) {
                    echo '
                    <div class="col-lg-4 col-md-6">
                        <div class="professional-doctors-card">
                            <div class="doctors-image">
                                <img src="https://bestcardiologists.in'. $row["imgurl1"].'" alt="'. $row["name"].'">
                            </div>
                            <div class="doctors-content">
                                <span>Experience: '. $row["experience"].' + years</span><br>
                                <span>Location: '. $row["location"].'</span><br>
                                <span>'. $row["designation"].'</span>
                                <h3>'. $row["name"].'</h3>
                            </div>
                        </div>
                      </div>';
                }
            } else {
                echo "<p>No doctors found for the selected filters.</p>";
            }

            // Free result set
            $result->free();
            // Close connection
            $conn->close();
            ?>
        </div>
    </div>
</div>
<!-- End Doctor Area -->

