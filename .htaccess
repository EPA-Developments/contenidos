<IfModule mod_rewrite.c>
    RewriteEngine On
    # Dominio: contenidos.segundaopinionmedica.org. Los dominios anteriores (si apuntan a este
    # servidor) redirigen ahí con la misma ruta.
    RewriteCond %{HTTP_HOST} ^(www\.)?epa-bienestar\.com\.ar$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^plataforma\.epa-bienestar\.com\.ar$ [NC]
    RewriteRule ^(.*)$ https://contenidos.segundaopinionmedica.org/$1 [L,R=301]
    # Turnos: los formularios viejos (book-appointment*) se reemplazaron por /turnos,
    # que conecta con Recepción de Segunda Opinión Médica (include/som-turnos.php).
    RewriteRule ^book-appointment(-epa)?(\.php)?/?$ /turnos [R=301,L]
    # Fichas de médicos de una plantilla de terceros (no son profesionales de EPA ni de SOM):
    # borradas; sus URLs van al listado de médicos.
    RewriteRule ^doctors/dr-(?!alejandro-dalessandro|alex-barbagelata|sergio-perrone)[a-z0-9-]+(\.php)?/?$ /doctors/ [R=301,L]
    # Biblioteca CKM-LE8: las 224 páginas viejas de suplementos y remedios se reescribieron con
    # evidencia en 9 artículos de /biblioteca; cada URL vieja va al que la reemplaza.
    RewriteRule ^blogs/(amaranth\-antioxidants\-for\-heart|antioxidants\-in\-apricots|antioxidants\-in\-brown\-rice|antioxidants\-in\-cheese|antioxidants\-in\-corn\-flour|antioxidants\-in\-cucumbers|antioxidants\-in\-figs|antioxidants\-in\-mango|antioxidants\-in\-peaches|antioxidants\-in\-pears|antioxidants\-in\-red\-wine|antioxidants\-in\-rice|antioxidants\-in\-sweet\-potatoes|barley\-antioxidants\-for\-heart\-health|blueberry\-antioxidants\-and\-heart\-health|broccoli\-antioxidants|cauliflower\-antioxidants|cherry\-antioxidants|chickpeas\-antioxidants|cranberries\-and\-antioxidants|grape\-antioxidants|guava\-antioxidants|kiwi\-antioxidants|lettuce\-antioxidants|millet\-antioxidants|mulberries\-and\-antioxidants|oranges\-as\-natural\-antioxidants|peas\-and\-antioxidants|plums\-antioxidants|pomegranate\-antioxidants\-heart\-disease|pomegranate\-seeds\-for\-heart\-health|soybean\-antioxidants\-heart|spinach\-antioxidants|sunflower\-antioxidants|tamarind\-antioxidants|tofu\-and\-antioxidants|tomato\-antioxidants\-and\-heart\-function)(\.php)?/?$ /biblioteca/alimentacion-cardiosaludable [R=301,L]
    RewriteRule ^blogs/(atherosclerosis\-and\-chocolate|cardioprotective\-effects\-of\-chocolate|chocolate\-and\-atherosclerosis|chocolate\-and\-blood\-flow|chocolate\-and\-blood\-sugar|chocolate\-and\-cholesterol|chocolate\-and\-heart\-health|chocolate\-and\-hypertension|dark\-chocolate\-and\-arrhythmia|dark\-chocolate\-and\-blood\-pressure|dark\-chocolate\-and\-cholesterol|dark\-chocolate\-and\-hypertension|dark\-chocolate\-cardiovascular\-benefits|dark\-chocolate\-for\-diabetes\-and\-heart\-health|dark\-chocolate\-for\-heart\-health|dark\-chocolate\-heart\-health|dark\-chocolate\-in\-cardiac\-rehab|flavonoids\-in\-chocolate)(\.php)?/?$ /biblioteca/chocolate-y-cacao [R=301,L]
    RewriteRule ^blogs/(aloe\-vera\-and\-antioxidants|aloe\-vera\-and\-cholesterol|aloe\-vera\-and\-heart\-health|aloe\-vera\-and\-heart\-rate\-variability|aloe\-vera\-for\-blood\-pressure|aloe\-vera\-for\-circulation|aloe\-vera\-for\-diabetes|aloe\-vera\-for\-heart\-disease|aloe\-vera\-for\-heart\-strengthening|aloe\-vera\-for\-inflammation|aloe\-vera\-juice\-for\-arrhythmias|aloe\-vera\-juice\-for\-blood\-clots|aloe\-vera\-juice\-for\-cholesterol|aloe\-vera\-juice\-for\-detoxification|aloe\-vera\-juice\-for\-heart\-disease\-prevention|aloe\-vera\-juice\-for\-heart\-health|aloe\-vera\-juice\-for\-hypertension|aloe\-vera\-juice\-for\-inflammation|aloe\-vera\-juice\-for\-recovery|aloe\-vera\-juice\-for\-stress\-relief|antioxidant\-clove\-benefits|antioxidant\-effects\-of\-saffron|antioxidants\-and\-rosemary|cinnamon\-and\-inflammation|cinnamon\-and\-weight\-loss|cinnamon\-antioxidants|cinnamon\-for\-blood\-circulation|cinnamon\-for\-blood\-pressure|cinnamon\-for\-cholesterol|cinnamon\-for\-diabetes|cinnamon\-for\-heart\-health|cinnamon\-stroke\-prevention|coriander\-antioxidants|fenugreek\-antioxidants|garlic\-and\-heart\-health|garlic\-and\-inflammation|garlic\-antioxidants\-for\-heart\-health|garlic\-for\-atherosclerosis|garlic\-for\-blood\-pressure|garlic\-for\-blood\-sugar\-control|garlic\-for\-heart\-function|garlic\-for\-lowering\-cholesterol|garlic\-for\-metabolic\-syndrome|garlic\-for\-stroke\-prevention|ginger\-and\-blood\-pressure|ginger\-and\-cardiovascular\-function|ginger\-and\-cardiovascular\-risk\-factors|ginger\-and\-cholesterol|ginger\-and\-circulation|ginger\-and\-healthy\-arteries|ginger\-and\-inflammation|ginger\-and\-post\-surgery\-recovery|ginger\-for\-heart\-disease|heart\-health\-and\-ginger|herbal\-tea\-for\-blood\-pressure|mustard\-antioxidants|mustard\-seeds\-for\-cholesterol)(\.php)?/?$ /biblioteca/especias-y-plantas-medicinales [R=301,L]
    RewriteRule ^blogs/(antioxidants\-in\-rosemary\-oil|coconut\-oil\-antioxidants|coconut\-oil\-for\-heart|mustard\-oil\-and\-antioxidants|palm\-oil\-and\-antioxidants)(\.php)?/?$ /biblioteca/grasas-y-aceites [R=301,L]
    RewriteRule ^blogs/(antioxidants\-in\-dates|antioxidants\-in\-dried\-fruit|antioxidants\-in\-honey|honey\-and\-blood\-pressure|honey\-and\-inflammation|honey\-and\-stroke\-risk|honey\-effects\-on\-the\-heart|honey\-for\-blood\-circulation|honey\-for\-cholesterol|honey\-for\-heart\-health|raisins\-antioxidants|raw\-honey\-for\-heart\-health)(\.php)?/?$ /biblioteca/miel-y-azucares-agregados [R=301,L]
    RewriteRule ^blogs/(amaranth\-seeds\-as\-a\-superfood|amaranth\-seeds\-for\-heart\-health|amaranth\-seeds\-for\-hypertension|antioxidants\-in\-almonds|antioxidants\-in\-fennel\-seed|antioxidants\-in\-peanuts|chia\-seeds\-and\-blood\-pressure|chia\-seeds\-and\-diabetes|chia\-seeds\-and\-heart\-health|chia\-seeds\-and\-inflammation|chia\-seeds\-as\-a\-supplement|chia\-seeds\-for\-cholesterol|chia\-seeds\-for\-heart\-disease\-prevention|chia\-seeds\-for\-heart\-health|cholesterol\-control\-pumpkin\-seeds|flax\-seeds\-and\-cardioprotection|flax\-seeds\-and\-cholesterol|flax\-seeds\-and\-heart\-attack\-prevention|flax\-seeds\-and\-inflammation|flax\-seeds\-for\-blood\-pressure|flax\-seeds\-for\-blood\-vessels|flax\-seeds\-for\-cardiovascular\-health|flax\-seeds\-for\-diabetes\-and\-heart\-disease|flax\-seeds\-for\-heart\-function|flax\-seeds\-for\-heart\-health|heart\-disease\-prevention\-pumpkin\-seeds|heart\-healthy\-seeds|hemp\-seeds\-for\-heart\-health|omega\-3\-fatty\-acids\-pumpkin\-seeds|omega\-3\-from\-chia\-seeds|omega\-3\-in\-amaranth\-seeds|omega\-3\-pumpkin\-seeds|pumpkin\-seeds\-antioxidants|pumpkin\-seeds\-cardiovascular\-health|pumpkin\-seeds\-cholesterol|pumpkin\-seeds\-for\-heart\-health|pumpkin\-seeds\-heart\-health|pumpkin\-seeds\-inflammation|pumpkin\-seeds\-post\-heart\-surgery\-recovery|seeds\-for\-heart\-and\-arteries|seeds\-for\-heart\-healthy\-diet|sesame\-seeds\-for\-heart\-health|sunflower\-seeds\-for\-heart\-health)(\.php)?/?$ /biblioteca/semillas-y-frutos-secos [R=301,L]
    RewriteRule ^blogs/(acacia\-antioxidant\-effects|alfalfa\-supplements\-for\-heart|antioxidant\-vitamins\-for\-the\-heart|antioxidants\-and\-cardiovascular\-disease|antioxidants\-for\-cardiovascular\-protection|antioxidants\-for\-heart|antioxidants\-heart\-disease|calcium\-supplements\-and\-heart\-health|citric\-acid\-antioxidants|glycerine\-as\-an\-antioxidant|iron\-supplementation\-for\-heart\-health|niacinamide\-heart\-health\-supplements|spirulina\-antioxidants|vitamin\-c\-supplements\-for\-heart)(\.php)?/?$ /biblioteca/suplementos-vitaminas-y-antioxidantes [R=301,L]
    RewriteRule ^blogs/(antioxidants\-in\-hibiscus|black\-tea\-for\-heart\-health|carrot\-juice\-for\-cardiovascular\-health|grape\-juice\-for\-heart\-health|green\-tea\-antioxidants|green\-tea\-for\-heart|green\-tea\-for\-heart\-health|green\-tea\-for\-hypertension|tea\-for\-circulation|tea\-for\-heart\-inflammation|tea\-for\-heart\-rhythm|tea\-for\-stroke\-prevention|white\-tea\-for\-heart\-health)(\.php)?/?$ /biblioteca/te-jugos-y-detox [R=301,L]
    RewriteRule ^blogs/(acetic\-acid\-and\-heart\-disease\-risk\-factors|acetic\-acid\-and\-heart\-health|acetic\-acid\-antioxidants\-cardiovascular\-health|acetic\-acid\-blood\-pressure\-regulation|acetic\-acid\-cardiovascular\-inflammation|acetic\-acid\-cholesterol\-control|acetic\-acid\-heart\-disease\-prevention|acetic\-acid\-metabolic\-health|acetic\-acid\-stroke\-prevention|apple\-cider\-vinegar\-and\-cholesterol|apple\-cider\-vinegar\-and\-weight\-loss|apple\-cider\-vinegar\-for\-atherosclerosis|apple\-cider\-vinegar\-for\-blood\-pressure|apple\-cider\-vinegar\-for\-blood\-sugar|apple\-cider\-vinegar\-for\-heart\-disease|apple\-cider\-vinegar\-for\-inflammation|apple\-cider\-vinegar\-for\-stroke\-prevention|apple\-cider\-vinegar\-for\-triglycerides|apple\-cider\-vinegar\-heart\-health\-benefits|baking\-soda\-for\-artery\-health|baking\-soda\-for\-blood\-pressure|baking\-soda\-for\-blood\-sugar|baking\-soda\-for\-cardiovascular\-fitness|baking\-soda\-for\-heart\-inflammation|baking\-soda\-heart\-disease)(\.php)?/?$ /biblioteca/vinagre-y-bicarbonato [R=301,L]
    # Remove .php extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
    # Redirect requests without .php to versions with .php
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php\ HTTP
    RewriteRule ^([^.]+)\.php$ /$1 [R=301,L]
    # gtranslate
    RewriteRule ^(es|af|sq|am|ar|hy|az|eu|be|bn|bs|bg|ca|ceb|ny|zh-CN|zh-TW|co|hr|cs|da|nl|en|eo|et|tl|fi|fr|fy|gl|ka|de|el|gu|ht|ha|haw|iw|hi|hmn|hu|is|ig|id|ga|it|ja|jw|kn|kk|km|ko|ku|ky|lo|la|lv|lt|lb|mk|mg|ms|ml|mt|mi|mr|mn|my|ne|no|ps|fa|pl|pt|pa|ro|ru|sm|gd|sr|st|sn|sd|si|sk|sl|so|es|su|sw|sv|tg|ta|te|th|tr|uk|ur|uz|vi|cy|xh|yi|yo|zu)/(af|sq|am|ar|hy|az|eu|be|bn|bs|bg|ca|ceb|ny|zh-CN|zh-TW|co|hr|cs|da|nl|en|eo|et|tl|fi|fr|fy|gl|ka|de|el|gu|ht|ha|haw|iw|hi|hmn|hu|is|ig|id|ga|it|ja|jw|kn|kk|km|ko|ku|ky|lo|la|lv|lt|lb|mk|mg|ms|ml|mt|mi|mr|mn|my|ne|no|ps|fa|pl|pt|pa|ro|ru|sm|gd|sr|st|sn|sd|si|sk|sl|so|es|su|sw|sv|tg|ta|te|th|tr|uk|ur|uz|vi|cy|xh|yi|yo|zu)/(.*)$ /$1/$3 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(es|af|sq|am|ar|hy|az|eu|be|bn|bs|bg|ca|ceb|ny|zh-CN|zh-TW|co|hr|cs|da|nl|en|eo|et|tl|fi|fr|fy|gl|ka|de|el|gu|ht|ha|haw|iw|hi|hmn|hu|is|ig|id|ga|it|ja|jw|kn|kk|km|ko|ku|ky|lo|la|lv|lt|lb|mk|mg|ms|ml|mt|mi|mr|mn|my|ne|no|ps|fa|pl|pt|pa|ro|ru|sm|gd|sr|st|sn|sd|si|sk|sl|so|es|su|sw|sv|tg|ta|te|th|tr|uk|ur|uz|vi|cy|xh|yi|yo|zu)/(.*)$ /gtranslate/gtranslate.php?glang=$1&gurl=$2 [L,QSA]
    RewriteRule ^(es|af|sq|am|ar|hy|az|eu|be|bn|bs|bg|ca|ceb|ny|zh-CN|zh-TW|co|hr|cs|da|nl|en|eo|et|tl|fi|fr|fy|gl|ka|de|el|gu|ht|ha|haw|iw|hi|hmn|hu|is|ig|id|ga|it|ja|jw|kn|kk|km|ko|ku|ky|lo|la|lv|lt|lb|mk|mg|ms|ml|mt|mi|mr|mn|my|ne|no|ps|fa|pl|pt|pa|ro|ru|sm|gd|sr|st|sn|sd|si|sk|sl|so|es|su|sw|sv|tg|ta|te|th|tr|uk|ur|uz|vi|cy|xh|yi|yo|zu)$ /$1/ [R=301,L]
</IfModule>
# Archivos internos que nunca se sirven (notas, backups, volcados, configuración).
<FilesMatch "\.(md|bak|save|orig|old|swp|sql|log|env|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^epa-config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
